# ===== AI Office — cấu hình =====
# Cổng & địa chỉ lắng nghe
PORT=8787
HOST=127.0.0.1

# BẮT BUỘC khi chạy production: khóa mã hóa thông tin xác thực (chuỗi ngẫu nhiên ≥ 32 ký tự)
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# URL công khai của server (https). Cần cho OAuth callback, ảnh Threads, ảnh bìa Zalo OA.
PUBLIC_BASE_URL=

# Tùy chọn: API key Claude (hoặc nhập trong giao diện Kết nối — được mã hóa trong DB)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Thư mục dữ liệu (SQLite + media), tương đối với thư mục server/
DATA_DIR=data
# Thư mục ảnh dùng để tạo thư viện mẫu ở lần chạy đầu (mặc định: ảnh sản phẩm ở gốc repo)
SEED_DIR=../..

WORKER_CONCURRENCY=4
DEMO_STEP_DELAY_MS=900
FB_GRAPH_VERSION=v23.0
# Đặt true khi chạy sau HTTPS
COOKIE_SECURE=false
